# GlassOS notifications (mako). Each notification plays your sound pack.
font=Inter 11
background-color=#1c1d2ab3
text-color=#f2f3f8
border-color=#ffffff4d
border-size=1
border-radius=18
padding=14,16
margin=10
outer-margin=6,6,0,0
width=380
height=180
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Glass-Dark:/usr/share/icons/Papirus-Dark
default-timeout=6000
layer=overlay
anchor=top-right
markup=1
format=<b>%s</b>\n%b
on-notify=exec glass-sound notification

[urgency=low]
on-notify=exec glass-sound notification-low
default-timeout=4000

[urgency=critical]
border-color=#ff8a8acc
default-timeout=0
on-notify=exec glass-sound notification-critical
