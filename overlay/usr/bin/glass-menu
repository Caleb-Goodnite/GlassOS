#!/bin/sh
# The GlassOS menu (click the logo in the top-left corner).
items="  About This Computer
  System Settings
  Glass Lens - What's Using My Computer
  Sound Packs
  App Store
  Change Wallpaper
  Software Updates
  GlassOS Help"
[ -d /run/live/medium ] && items="$items
  Install GlassOS"
items="$items
  Lock
  Log Out…
  Restart…
  Shut Down…"
choice="$(printf '%s\n' "$items" | fuzzel --dmenu --prompt "" --placeholder "GlassOS" --lines 14 --width 36 2>/dev/null)"
case "$choice" in
  *About*)       exec glass-launch glass-lens --page about ;;
  *"Glass Lens"*) exec glass-launch glass-lens ;;
  *Settings*)    exec glass-launch glass-settings ;;
  *"Sound Packs"*) exec glass-launch glass-lens --page sounds ;;
  *Wallpaper*)   exec glass-launch glass-settings --page appearance ;;
  *Updates*)     exec glass-launch foot --title "Software Updates" -e glass-update ;;
  *"App Store"*) exec glass-launch glass-store ;;
  *Help*)        exec glass-launch glass-help ;;
  *Install*)     exec glass-launch foot --title "Install GlassOS" -e sudo glass-install ;;
  *Lock*)        exec glass-lock ;;
  *"Log Out"*)   exec glass-power logout ;;
  *Restart*)     exec glass-power restart ;;
  *"Shut Down"*) exec glass-power shutdown ;;
esac
