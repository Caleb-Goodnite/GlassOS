#!/bin/bash
# glass-install: put GlassOS on this computer's disk.
#
# It asks which disk to use, shows exactly what it will do, and changes nothing until you
# confirm. GlassOS takes either the whole disk, or (dual boot) free space or one partition on
# it, next to Windows or another system; the boot menu then offers both.
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

SQUASH=/run/live/medium/live/filesystem.squashfs
T=/mnt/glassos-target
ARCH="$(dpkg --print-architecture)"
B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; C=$'\e[1;36m'; RED=$'\e[1;31m'; G=$'\e[1;32m'

say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s%s%s\n' "$C" "$R" "$B" "$*" "$R"; }
die()  { printf '\n%sCannot continue:%s %s\n' "$RED" "$R" "$*" >&2; read -r -p "Press Enter to close." _ || true; DIED=1; exit 1; }
DIED=""
ask()  { local __v; read -r -p "$1" __v; printf '%s' "$__v"; }

cleanup() {
  local rc=$?
  set +e
  # a step failed: keep the window open so the error above can be read (opened from the
  # "Install GlassOS" icon, the window would otherwise close at once)
  if [ "$rc" != 0 ] && [ -z "$DIED" ]; then
    printf '\n%sThe install stopped because the step above failed.%s The computer may not start\n' "$RED" "$R" >&2
    printf 'GlassOS yet. Take a photo of this window, then press Enter to close it.\n' >&2
    read -r _ || true
  fi
  mountpoint -q /mnt/glassos-esp 2>/dev/null && umount /mnt/glassos-esp
  for m in sys/firmware/efi/efivars sys proc dev/pts dev run boot/efi ""; do
    mountpoint -q "$T/$m" 2>/dev/null && umount -R "$T/$m" 2>/dev/null
  done
}
trap cleanup EXIT

clear
cat <<EOF
${B}Install GlassOS${R}

This copies the system you're using right now onto a disk inside this computer.
It takes about 5-10 minutes. You can stop at any point before you type ERASE.

EOF
[ -f "$SQUASH" ] || die "this only works from the GlassOS live USB/DVD (couldn't find $SQUASH)."
if [ -d /sys/firmware/efi ]; then FIRMWARE=UEFI; else FIRMWARE=BIOS; fi
[ "$ARCH" = arm64 ] && [ "$FIRMWARE" = BIOS ] && die "ARM computers need UEFI firmware to boot GlassOS."
say "This computer starts in ${B}$FIRMWARE${R} mode."
if [ "$FIRMWARE" = UEFI ] && [ "$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | tr -d ' ')" = 1 ]; then
  say "${RED}Secure Boot is on.${R} GlassOS isn't signed for Secure Boot yet, so after installing,"
  say "turn Secure Boot off in your firmware settings or the computer won't start GlassOS."
fi

# ----------------------------------------------------------------------------- disk
step "Choose the disk"
live_src="$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)"
live_disk=""
[ -n "$live_src" ] && live_disk="$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -n1 || true)"
mapfile -t DISKS < <(lsblk -dpno NAME,TYPE,RO | awk '$2=="disk" && $3=="0" {print $1}' | grep -v -E '/dev/(loop|sr|zram|ram)')
CHOICES=()
for d in "${DISKS[@]}"; do
  [ "$(basename "$d")" = "$live_disk" ] && continue
  CHOICES+=("$d")
done
[ ${#CHOICES[@]} -gt 0 ] || die "no disk found to install on (the USB stick you started from can't be used)."
i=1
for d in "${CHOICES[@]}"; do
  size="$(lsblk -dno SIZE "$d" | xargs)"
  model="$(lsblk -dno MODEL "$d" | xargs)"
  tran="$(lsblk -dno TRAN "$d" | xargs)"
  parts="$(lsblk -no NAME,FSTYPE,LABEL,SIZE "$d" | tail -n +2 | sed 's/^[^a-zA-Z0-9]*/      /')"
  printf '  %s%d)%s %s  %s%s  %s%s\n' "$B" "$i" "$R" "$d" "$size" "${model:+  $model}" "$D${tran:+($tran)}" "$R"
  [ -n "$parts" ] && printf '%s%s%s\n' "$D" "$parts" "$R"
  i=$((i + 1))
done
n="$(ask "Disk number: ")"
[[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#CHOICES[@]} ] || die "that isn't one of the numbers above."
DISK="${CHOICES[$((n - 1))]}"
part() { if [[ "$DISK" =~ [0-9]$ ]]; then echo "${DISK}p$1"; else echo "${DISK}$1"; fi; }
MIN=$((12 * 1024 * 1024 * 1024))   # GlassOS needs 12 GB

# ----------------------------------------------------------------------------- whole disk or next to
MODE=erase; ESP=""; WINDOWS=0; LABEL=gpt; TKIND=""
if [ -n "$(lsblk -lnpo NAME "$DISK" | tail -n +2)" ]; then
  step "Keep what's already on $DISK?"
  say "  ${B}1)${R} Erase the whole disk and use all of it for GlassOS"
  say "  ${B}2)${R} Keep what's on it and put GlassOS next to it (dual boot: you pick a system"
  say "     each time the computer starts)"
  m="$(ask "1 or 2: ")"
  case "$m" in 1) MODE=erase ;; 2) MODE=alongside ;; *) die "type 1 or 2." ;; esac
fi

if [ "$MODE" = erase ]; then
  [ "$(lsblk -bdno SIZE "$DISK")" -ge "$MIN" ] || die "$DISK is too small (GlassOS needs at least 12 GB)."
else
  LABEL="$(parted -sm "$DISK" print 2>/dev/null | sed -n 2p | cut -d: -f6)"
  case "$LABEL" in gpt|msdos) ;; *) die "GlassOS can't add a partition to $DISK. Choose 1 to erase it instead." ;; esac
  # the other system's EFI partition: GlassOS's boot loader goes in it too
  for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do
    case "$(lsblk -dno PARTTYPE "$p" | tr '[:upper:]' '[:lower:]')" in
      c12a7328-f81f-11d2-ba4b-00a0c93ec93b|0xef) ESP="$p"; break ;;
    esac
  done
  if [ "$FIRMWARE" = UEFI ]; then
    [ -n "$ESP" ] || die "$DISK has no EFI system partition, so the system on it starts the older (BIOS) way.
  Start this USB stick in BIOS/legacy mode instead (in your firmware's boot menu), or choose 1."
  elif [ "$LABEL" = gpt ] && ! lsblk -no PARTTYPE "$DISK" | grep -qi 21686148-6449-6e6f-744e-656564454649; then
    die "this USB stick started in BIOS mode, but the system on $DISK starts in UEFI mode.
  Restart and pick the USB stick's UEFI entry in your firmware's boot menu."
  fi
  lsblk -no FSTYPE "$DISK" | grep -qx ntfs && WINDOWS=1
  if [ -n "$ESP" ]; then
    mkdir -p /mnt/glassos-esp
    mount -o ro "$ESP" /mnt/glassos-esp || die "couldn't read the EFI partition $ESP."
    esp_free="$(df -Pm /mnt/glassos-esp | awk 'NR == 2 {print $4}')"
    [ -d /mnt/glassos-esp/EFI/Microsoft ] && WINDOWS=1
    umount /mnt/glassos-esp
    [ "$esp_free" -ge 12 ] || die "the EFI partition $ESP is full (${esp_free} MB free, GlassOS's boot loader needs 12 MB)."
  fi

  step "Where should GlassOS go?"
  T_KIND=(); T_A=(); T_B=(); T_PART=(); T_DESC=()
  # free (unpartitioned) space of 12 GB or more
  while read -r a b; do
    T_KIND+=(free); T_A+=("$a"); T_B+=("$b"); T_PART+=("")
    T_DESC+=("Free space, $(numfmt --to=iec --suffix=B $((b - a + 1))) (nothing uses it)")
  done < <(parted -sm "$DISK" unit B print free 2>/dev/null | tr -d B \
            | awk -F: -v min="$MIN" '$5 ~ /^free/ && $3 - $2 + 1 >= min {print $2, $3}')
  # or a partition of 12 GB or more, which is erased (never the EFI, Microsoft reserved,
  # Windows recovery or BIOS boot partitions)
  for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do
    case "$(lsblk -dno PARTTYPE "$p" | tr '[:upper:]' '[:lower:]')" in
      c12a7328-f81f-11d2-ba4b-00a0c93ec93b|0xef|e3c9e316-0b5c-4db8-817d-f92df00215ae|\
      de94bba4-06d1-4d40-a16a-bfd50179d6ac|21686148-6449-6e6f-744e-656564454649|0x27) continue ;;
    esac
    [ "$(lsblk -bdno SIZE "$p")" -ge "$MIN" ] || continue
    fs="$(lsblk -dno FSTYPE "$p")"; lbl="$(lsblk -dno LABEL "$p")"
    warn="erased if you pick it"
    [ "$fs" = ntfs ] && warn="${RED}probably Windows' own files: erased if you pick it${R}"
    T_KIND+=(part); T_A+=(""); T_B+=(""); T_PART+=("$p")
    T_DESC+=("$p  $(lsblk -dno SIZE "$p" | xargs)  ${fs:-unformatted}${lbl:+ \"$lbl\"}  ($warn)")
  done
  if [ ${#T_KIND[@]} -eq 0 ]; then
    cat <<EOF
There's no room for GlassOS on $DISK yet. It needs 12 GB of free space (more is better: 30 GB
or more leaves room for your files). Make room by shrinking the other system, then come back:
  - ${B}Windows:${R} right-click Start > Disk Management, right-click (C:) > Shrink Volume, and
    shrink it by 30 GB or more. Leave the new space "Unallocated", then restart from this
    USB stick and run the installer again.
  - ${B}Linux:${R} shrink its partition with its disk tool (for example GParted), leaving the
    space unallocated.
EOF
    die "no free space on $DISK."
  fi
  i=1
  for d in "${T_DESC[@]}"; do printf '  %s%d)%s %s\n' "$B" "$i" "$R" "$d"; i=$((i + 1)); done
  say "${D}  No free space listed? Shrink the other system first (Windows: Disk Management >"
  say "  Shrink Volume), then run the installer again.${R}"
  n="$(ask "Number: ")"
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#T_KIND[@]} ] || die "that isn't one of the numbers above."
  n=$((n - 1))
  TKIND="${T_KIND[$n]}"; TA="${T_A[$n]}"; TB="${T_B[$n]}"; TPART="${T_PART[$n]}"
fi

# ----------------------------------------------------------------------------- you
step "Your account"
FULLNAME="$(ask "Your name (shown on the login screen): ")"
while :; do
  USERNAME="$(ask "Username (lowercase, no spaces) [$(echo "${FULLNAME%% *}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')]: ")"
  [ -n "$USERNAME" ] || USERNAME="$(echo "${FULLNAME%% *}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')"
  if [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$USERNAME" != root ] && [ "$USERNAME" != glass ]; then break; fi
  say "  Use lowercase letters, digits, - or _, starting with a letter (not 'root' or 'glass')."
done
while :; do
  read -r -s -p "Password: " PASS1; echo
  read -r -s -p "Password again: " PASS2; echo
  [ "$PASS1" = "$PASS2" ] || { say "  They didn't match, try again."; continue; }
  [ ${#PASS1} -ge 4 ] || { say "  Use at least 4 characters."; continue; }
  break
done
HOSTNAME_NEW="$(ask "Computer name [glassos]: ")"
HOSTNAME_NEW="${HOSTNAME_NEW:-glassos}"
[[ "$HOSTNAME_NEW" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || die "computer names can only use letters, digits and -."
guess_tz="$(timedatectl show -p Timezone --value 2>/dev/null || echo Etc/UTC)"
TZ_NEW="$(ask "Time zone, e.g. America/Chicago or Europe/London [$guess_tz]: ")"
TZ_NEW="${TZ_NEW:-$guess_tz}"
[ -f "/usr/share/zoneinfo/$TZ_NEW" ] || { say "  Unknown time zone, using UTC (change later: sudo timedatectl set-timezone ...)"; TZ_NEW=Etc/UTC; }
AUTOLOGIN="$(ask "Log in automatically without a password at startup? [y/N]: ")"
case "$AUTOLOGIN" in y|Y|yes|Yes) AUTOLOGIN=1 ;; *) AUTOLOGIN=0 ;; esac

# ----------------------------------------------------------------------------- confirm
step "Here's exactly what will happen"
disk_desc="$(echo "$(lsblk -dno SIZE "$DISK") $(lsblk -dno MODEL "$DISK")" | xargs)"
bios_line=""
[ "$ARCH" = amd64 ] && bios_line="       - 1 MB    BIOS boot (lets older PCs start GlassOS)
"
WORD=ERASE
if [ "$MODE" = erase ]; then
cat <<EOF
  1. ${RED}Everything on $DISK ($disk_desc) is erased.${R}
  2. It gets a new GPT partition table:
${bios_line}       - 512 MB  EFI system partition (FAT32): the boot loader
       - the rest: GlassOS (ext4), with a 2 GB swap file
  3. GlassOS is copied onto it, user "$USERNAME" is created, the live "glass" account is removed.
  4. GRUB is installed as the boot loader ($( [ "$ARCH" = amd64 ] && echo "UEFI and BIOS" || echo "UEFI" )).
EOF
else
  if [ "$TKIND" = free ]; then
    WORD=INSTALL
    first="A new GlassOS partition (ext4) fills the free space, $(numfmt --to=iec --suffix=B $((TB - TA + 1))).
     Nothing else on $DISK is touched."
  else
    first="${RED}$TPART ($(lsblk -dno SIZE "$TPART" | xargs) $(lsblk -dno FSTYPE "$TPART")) is erased${R} and becomes GlassOS (ext4).
     Nothing else on $DISK is touched."
  fi
  if [ -n "$ESP" ]; then
    boot="GlassOS's boot loader is added to the EFI partition $ESP, beside the other system's."
  else
    boot="GRUB goes in the start of $DISK, in place of the other system's boot code."
  fi
cat <<EOF
  1. $first
  2. GlassOS is copied onto it, user "$USERNAME" is created, the live "glass" account is removed.
  3. $boot
  4. When the computer starts, a menu offers GlassOS (the default after 5 seconds) and the
     other system$( [ "$WINDOWS" = 1 ] && echo " (Windows Boot Manager)").
EOF
  if [ "$WINDOWS" = 1 ]; then say "
  ${B}If Windows uses BitLocker${R}, have its recovery key ready (aka.ms/myrecoverykey): Windows
  may ask for it once after the boot menu changes."; fi
fi
echo
c="$(ask "Type $WORD (in capitals) to install, anything else to cancel: ")"
[ "$c" = "$WORD" ] || { say "Cancelled. Nothing was changed."; read -r -p "Press Enter to close." _ || true; exit 0; }

# ----------------------------------------------------------------------------- go
step "Preparing $DISK"
swapoff -a 2>/dev/null || true
for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do umount -f "$p" 2>/dev/null || true; done
if [ "$MODE" = erase ]; then
  wipefs -af "$DISK" >/dev/null
  parted -s "$DISK" mklabel gpt
  if [ "$ARCH" = amd64 ]; then
    parted -s "$DISK" mkpart biosboot 1MiB 2MiB set 1 bios_grub on
    parted -s "$DISK" mkpart EFI fat32 2MiB 514MiB set 2 esp on
    parted -s "$DISK" mkpart GlassOS ext4 514MiB 100%
    ESP="$(part 2)"; ROOTP="$(part 3)"
  else
    parted -s "$DISK" mkpart EFI fat32 1MiB 513MiB set 1 esp on
    parted -s "$DISK" mkpart GlassOS ext4 513MiB 100%
    ESP="$(part 1)"; ROOTP="$(part 2)"
  fi
  partprobe "$DISK" 2>/dev/null || true
  udevadm settle
  for _ in $(seq 20); do [ -b "$ROOTP" ] && break; sleep 0.5; done
  mkfs.vfat -F 32 -n EFI "$ESP" >/dev/null
elif [ "$TKIND" = free ]; then
  # a new partition in the free space, on whole-MiB boundaries inside it
  before="$(lsblk -lnpo NAME "$DISK" | tail -n +2 | sort)"
  start=$(( (TA + 1048575) / 1048576 )); end=$(( (TB + 1) / 1048576 ))
  if [ "$LABEL" = gpt ]; then
    parted -s "$DISK" unit MiB mkpart GlassOS ext4 "$start" "$end" || die "couldn't make a partition in the free space."
  else
    parted -s "$DISK" unit MiB mkpart primary ext4 "$start" "$end" \
      || die "couldn't make a partition in the free space (an older MBR disk holds at most 4 partitions)."
  fi
  partprobe "$DISK" 2>/dev/null || true
  udevadm settle
  ROOTP=""
  for _ in $(seq 20); do
    ROOTP="$(comm -13 <(printf '%s\n' "$before") <(lsblk -lnpo NAME "$DISK" | tail -n +2 | sort) | head -n1)"
    [ -n "$ROOTP" ] && [ -b "$ROOTP" ] && break; sleep 0.5
  done
  [ -n "$ROOTP" ] || die "the new partition didn't show up. Restart from the USB stick and try again."
else
  ROOTP="$TPART"
  swapoff "$ROOTP" 2>/dev/null || true
  wipefs -af "$ROOTP" >/dev/null
  # mark it as a Linux partition, so Windows doesn't offer to format it
  num="$(cat "/sys/class/block/$(basename "$ROOTP")/partition")"
  if [ "$LABEL" = gpt ]; then
    parted -s "$DISK" type "$num" 0FC63DAF-8483-4772-8E79-3D69D8477DE4 2>/dev/null || true
    parted -s "$DISK" name "$num" GlassOS 2>/dev/null || true
  else
    parted -s "$DISK" type "$num" 0x83 2>/dev/null || true
  fi
  partprobe "$DISK" 2>/dev/null || true
  udevadm settle
fi
mkfs.ext4 -F -q -L GlassOS "$ROOTP"

step "Copying GlassOS onto the disk"
mkdir -p "$T"
mount "$ROOTP" "$T"
unsquashfs -f -d "$T" "$SQUASH"
mkdir -p "$T/boot/efi"
[ -z "$ESP" ] || mount "$ESP" "$T/boot/efi"

step "Setting up your system"
# GlassOS's own files must have arrived (a Dell install once lacked the login screen program)
for f in usr/bin/glass-greeter usr/bin/glass-session usr/share/glassos/build-info; do
  [ -e "$T/$f" ] || die "GlassOS files are missing from the copy (/$f). Try another USB stick or ISO."
done
ROOT_UUID="$(blkid -s UUID -o value "$ROOTP")"
ESP_UUID=""
[ -z "$ESP" ] || ESP_UUID="$(blkid -s UUID -o value "$ESP")"
fallocate -l 2G "$T/swapfile" && chmod 600 "$T/swapfile" && mkswap -q "$T/swapfile"
cat > "$T/etc/fstab" <<EOF
# <what>                                <where>     <type> <options>          <dump> <check>
UUID=$ROOT_UUID  /          ext4   errors=remount-ro  0      1
$( [ -n "$ESP_UUID" ] && echo "UUID=$ESP_UUID                          /boot/efi  vfat   umask=0077         0      1")
/swapfile                                none       swap   sw                 0      0
EOF
# Windows keeps the hardware clock in local time; read it the same way, so neither system
# shows the wrong time after the other ran
[ "$WINDOWS" = 1 ] && printf '0.0 0 0.0\n0\nLOCAL\n' > "$T/etc/adjtime"
echo "$HOSTNAME_NEW" > "$T/etc/hostname"
sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$HOSTNAME_NEW/" "$T/etc/hosts"
ln -sf "/usr/share/zoneinfo/$TZ_NEW" "$T/etc/localtime"
echo "$TZ_NEW" > "$T/etc/timezone"

for m in dev proc sys run; do mkdir -p "$T/$m"; done
mount --rbind /dev "$T/dev"; mount --make-rslave "$T/dev"
mount -t proc proc "$T/proc"
mount --rbind /sys "$T/sys"; mount --make-rslave "$T/sys"
mount -t tmpfs tmpfs "$T/run"
cp -L /etc/resolv.conf "$T/etc/resolv.conf" 2>/dev/null || true
inc() { chroot "$T" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
          DEBIAN_FRONTEND=noninteractive "$@"; }

# your account replaces the live one
inc userdel -r glass >/dev/null 2>&1 || true
groups=""
for g in sudo audio video render input netdev plugdev users; do
  inc getent group "$g" >/dev/null && groups="${groups:+$groups,}$g"
done
inc useradd -m -s /bin/bash -c "$FULLNAME" -G "$groups" "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASS1" | inc chpasswd
unset PASS1 PASS2
for d in Desktop Documents Downloads Music Pictures Videos "Music/Sound Packs" Pictures/Screenshots; do
  inc install -d -o "$USERNAME" -g "$USERNAME" "/home/$USERNAME/$d"
done
rm -f "$T/etc/sudoers.d/glassos-live" "$T/usr/share/applications/glass-install.desktop"

# login screen
{
  echo "# GlassOS login manager (written by the installer)"
  echo "[terminal]"
  echo "vt = 1"
  echo
  echo "[default_session]"
  echo 'command = "glass-greeter"'
  echo "user = \"_greetd\""
  if [ "$AUTOLOGIN" = 1 ]; then
    echo
    echo "# automatic login (you chose this during install; delete these 3 lines to turn it off)"
    echo "[initial_session]"
    echo "command = \"glass-session\""
    echo "user = \"$USERNAME\""
  fi
} > "$T/etc/greetd/config.toml.new"
# replace the live USB's file (its automatic login is for the "glass" account, deleted above)
mv -f "$T/etc/greetd/config.toml.new" "$T/etc/greetd/config.toml"
grep -q 'written by the installer' "$T/etc/greetd/config.toml" || die "couldn't write the login screen settings."

step "Removing the live-USB parts"
inc apt-get purge -y -q live-boot live-boot-initramfs-tools >/dev/null 2>&1 || true
inc update-initramfs -u -k all

step "Installing the GRUB boot loader"
install -d "$T/boot/grub/themes"
rm -rf "$T/boot/grub/themes/glassos"
# the boot menu's look: from the installed system, else from the USB stick, else plain menu
theme=""
for d in "$T/usr/share/glassos/grub-theme" /run/live/medium/boot/grub/themes/glassos; do
  [ -f "$d/theme.txt" ] && { theme="$d"; break; }
done
if [ -n "$theme" ]; then
  cp -r "$theme" "$T/boot/grub/themes/glassos"
else
  say "(No boot menu theme found: the boot menu will be plain text.)"
  sed -i 's/^GRUB_THEME=/#GRUB_THEME=/' "$T/etc/default/grub" 2>/dev/null || true
fi
if mountpoint -q /sys/firmware/efi/efivars 2>/dev/null; then :; elif [ -d /sys/firmware/efi/efivars ]; then
  mount -t efivarfs efivarfs "$T/sys/firmware/efi/efivars" 2>/dev/null || true
fi
efi_target=x86_64-efi; [ "$ARCH" = arm64 ] && efi_target=arm64-efi
nvram=1
if [ "$FIRMWARE" = UEFI ]; then
  inc grub-install --target="$efi_target" --efi-directory=/boot/efi --bootloader-id=GlassOS --recheck \
    || { nvram=0; inc grub-install --target="$efi_target" --efi-directory=/boot/efi --bootloader-id=GlassOS --no-nvram; }
fi
# also the fallback path (EFI/BOOT/BOOT*.EFI) for firmware that forgets boot entries, or if
# this disk is later moved to another computer. Next to another system, only when the firmware
# wouldn't take GlassOS's boot entry: that path may be the other system's own way in.
if [ -n "$ESP" ] && { [ "$MODE" = erase ] || [ "$nvram" = 0 ]; }; then
  inc grub-install --target="$efi_target" --efi-directory=/boot/efi --removable --no-nvram
fi
if [ "$ARCH" = amd64 ] && { [ "$MODE" = erase ] || [ "$FIRMWARE" = BIOS ]; }; then
  inc grub-install --target=i386-pc "$DISK"
fi
if [ "$MODE" = alongside ]; then
  # time to pick a system, and os-prober finds the others (Windows Boot Manager, Linux...)
  sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' "$T/etc/default/grub"
  grep -q '^GRUB_DISABLE_OS_PROBER=false' "$T/etc/default/grub" || echo 'GRUB_DISABLE_OS_PROBER=false' >> "$T/etc/default/grub"
fi
inc update-grub

rm -f "$T/etc/resolv.conf"
sync
cleanup
trap - EXIT

cat <<EOF

${G}GlassOS is installed.${R}

  Remove the USB stick or DVD, then restart.$( [ "$MODE" = alongside ] && printf '\n  At startup, pick GlassOS or your other system in the boot menu.' )
  Log in as ${B}$USERNAME${R}. Admin tasks (installing software, updates) ask for your password.

EOF
r="$(ask "Restart now? [Y/n]: ")"
case "$r" in n|N|no) exit 0 ;; *) systemctl reboot ;; esac
