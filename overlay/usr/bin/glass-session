#!/bin/sh
# GlassOS desktop session launcher (run by the login manager, greetd).
# Writes a few machine-specific Hyprland settings, then starts Hyprland.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONF/hypr"

# First login for an account created before the skeleton had a Hyprland config
[ -f "$CONF/hypr/hyprland.lua" ] || cp -n /etc/skel/.config/hypr/hyprland.lua "$CONF/hypr/"

# prints "none" (and fails) on real hardware, so no "|| echo none": that made it "none<newline>none"
# and broke machine.lua
VIRT="$(systemd-detect-virt --vm 2>/dev/null)"
VIRT="${VIRT:-none}"

# Is there graphics acceleration? Without it (most virtual machines, or a PC whose GPU has no
# driver) every frame is drawn by the processor, so GlassOS uses lighter glass effects.
GPU=/sys/class/drm/card0/device
DRV="$(basename "$(readlink -f "$GPU/driver" 2>/dev/null)" 2>/dev/null)"
if [ "$DRV" = virtio-pci ]; then
  # a virtio GPU on PCI: the graphics driver sits on the virtio device below it
  for v in "$GPU"/virtio*; do
    [ -e "$v/driver" ] && GPU="$v" && DRV="$(basename "$(readlink -f "$v/driver")")"
  done
fi
ACCEL=yes
case "$DRV" in
  ""|simpledrm|simple-framebuffer|efifb|bochs*|cirrus*|qxl|hyperv_drm|vboxvideo|virtio-pci) ACCEL=no ;;
  virtio_gpu|virtio-gpu)
    # feature bit 0 of the virtio device is 3D (virgl); without it Mesa renders in software
    [ "$(cut -c1 "$GPU/features" 2>/dev/null)" = 1 ] || ACCEL=no ;;
esac
[ -e /dev/dri/renderD128 ] || ACCEL=no
case "$(sed -n 's/^effects *= *//p' "$CONF/glassos/desktop.conf" 2>/dev/null)" in
  full) ACCEL=yes ;; light) ACCEL=no ;;
esac
{
  echo "-- Generated by glass-session at every login. Do not edit; use custom.lua instead."
  echo "-- Detected virtualisation: $VIRT, graphics driver: ${DRV:-none}, acceleration: $ACCEL" | tr -d '\r' | head -n1
  if [ "$VIRT" != "none" ]; then
    # Virtual GPUs often lack a hardware cursor plane
    echo 'hl.config({ cursor = { no_hardware_cursors = true } })'
  fi
  if [ "$ACCEL" = no ]; then echo 'return { light = true }'; else echo 'return { light = false }'; fi
} > "$CONF/hypr/machine.lua"

# Apps installed from the App Store (Flatpak) show up in search and the dock
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_CURRENT_DESKTOP=Hyprland

# No LIBGL_ALWAYS_SOFTWARE here: Mesa already draws in software when there's no 3D driver,
# and forcing it makes Hyprland quit at start ("Not allowed to force software rendering when
# API explicitly selects a hardware device"). Without acceleration only the effects get lighter.

# The desktop's own messages go to the system journal (journalctl --user -t hyprland),
# not across the screen while it starts.
if command -v systemd-cat >/dev/null 2>&1; then
  if command -v start-hyprland >/dev/null 2>&1; then exec systemd-cat -t hyprland start-hyprland; fi
  exec systemd-cat -t hyprland Hyprland
fi
if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland
fi
exec Hyprland
