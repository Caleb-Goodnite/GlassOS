#!/bin/sh
# glass-screenshot [screen|area]  - saves to Pictures/Screenshots and copies to clipboard
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"
case "${1:-screen}" in
  area) geom="$(slurp -b 00000066 -c ffffffcc -w 1)" || exit 0; grim -g "$geom" "$file" || exit 1 ;;
  *)    grim "$file" || exit 1 ;;
esac
wl-copy < "$file" 2>/dev/null
glass-sound screenshot
notify-send -a Screenshot -i "$file" "Screenshot saved" "$(basename "$file") (also copied, ready to paste)"
