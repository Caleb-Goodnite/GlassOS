#!/bin/sh
# GlassOS power dialog: glass-power [shutdown|restart|logout]
# Shortcut: Super+Option+Delete (Mac keyboard) or Super+Alt+Backspace (PC keyboard).
# It counts down 60 seconds before doing anything, and Cancel or Esc closes it.
for lib in /usr/lib/*/libgtk4-layer-shell.so.0 /usr/lib/libgtk4-layer-shell.so.0; do
  if [ -e "$lib" ]; then
    export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
    break
  fi
done
exec python3 /usr/lib/glassos/apps/power.py "$@"
