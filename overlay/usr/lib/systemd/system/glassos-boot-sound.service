[Unit]
Description=GlassOS boot sound (plays the "boot" sound from your sound pack)
Documentation=file:///usr/share/glassos/soundpacks/README.md
After=sound.target alsa-restore.service systemd-udev-trigger.service
Before=greetd.service display-manager.service
ConditionPathExists=!/etc/glassos/no-boot-sound

[Service]
Type=oneshot
ExecStart=/usr/lib/glassos/boot-sound
# up to 4 s waiting for the sound card, then up to 15 s of sound (boot-sound)
TimeoutStartSec=22

[Install]
WantedBy=multi-user.target
