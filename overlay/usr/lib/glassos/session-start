#!/bin/sh
# Everything GlassOS starts in your desktop session. Nothing else runs behind your back.
# Each piece runs in its own "scope" so Glass Lens can show exactly what it costs.

desk() {  # desk <unit-name> <command...>
  name="$1"; shift
  systemd-run --user --scope --quiet --collect --slice=glass-desktop.slice \
    --unit="glass-$name" --description="GlassOS desktop: $name" -- "$@" >/dev/null 2>&1 &
}

# Every window needs a title bar to close it. Hyprland's hyprbars plugin draws one on other apps'
# windows; if the plugin is missing or failed to load, older (GTK 3) apps such as Files draw their
# own instead (GTK_CSD=1), with the same red/yellow/green buttons (gtk-3.0/gtk.css).
if [ "$GTK_CSD" != 1 ] && ! hyprctl plugin list 2>/dev/null | grep -qi hyprbars; then
  export GTK_CSD=1
  hyprctl eval 'hl.env("GTK_CSD", "1")' >/dev/null 2>&1   # for apps Hyprland starts (shortcuts)
fi
csd=""
[ "$GTK_CSD" = 1 ] && csd=GTK_CSD

# Let user services (sound daemon, portals) talk to this Wayland session. Files runs as a
# background service that D-Bus starts, so it only sees what is passed on here (GTK_CSD too).
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE DISPLAY XCURSOR_THEME XCURSOR_SIZE $csd 2>/dev/null

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
WALL="$(sed -n 's/^wallpaper *= *//p' "$CONF/glassos/desktop.conf" 2>/dev/null)"
[ -f "$WALL" ] || WALL=/usr/share/glassos/wallpapers/prism.jpg

desk wallpaper swaybg -m fill -i "$WALL"
desk topbar    waybar -c "$CONF/waybar/top.jsonc" -s "$CONF/waybar/top.css"
desk dock      /usr/lib/glassos/dock/glass-dock
desk notifications mako
desk idle      hypridle
[ -x /usr/libexec/polkit-mate-authentication-agent-1 ] && \
  desk polkit  /usr/libexec/polkit-mate-authentication-agent-1
systemctl --user start glass-soundd.service 2>/dev/null

xdg-user-dirs-update 2>/dev/null

# Login chime from your sound pack
glass-sound login

# First run: show the welcome tour
if [ ! -f "$CONF/glassos/.welcomed" ]; then
  mkdir -p "$CONF/glassos" && touch "$CONF/glassos/.welcomed"
  (sleep 2; glass-launch glass-lens --page welcome) &
fi

# Booted with "Install GlassOS" from the boot menu: open the installer
if grep -qw glassos.install /proc/cmdline; then
  (sleep 3; glass-launch foot --title "Install GlassOS" -e sudo glass-install) &
fi
