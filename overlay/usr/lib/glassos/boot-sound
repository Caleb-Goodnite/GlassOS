#!/bin/sh
# Plays the boot sound. Runs once per boot, before the login screen, straight to the
# sound card (the desktop sound server isn't running yet).
# Turn it off with:  sudo touch /etc/glassos/no-boot-sound

f="$(ls /var/lib/glassos/sounds/boot.* 2>/dev/null | head -n1)"
if [ -z "$f" ]; then
  pack="$(sed -n 's/^DEFAULT_SOUNDPACK=//p' /usr/share/glassos/build-info 2>/dev/null)"
  dir="/usr/share/glassos/soundpacks/${pack:-glassos-default}"
  # a pack can name its boot file in pack.ini ([files] boot = Startup.wav)
  name="$(sed -n '/^\[files\]/,/^\[/ s/^ *boot *= *//p' "$dir/pack.ini" 2>/dev/null | head -n1)"
  case "$name" in */*|"") f="" ;; *) [ -f "$dir/$name" ] && f="$dir/$name" ;; esac
  [ -n "$f" ] || f="$(ls "$dir"/boot.* 2>/dev/null | head -n1)"
fi
[ -n "$f" ] || exit 0

vol="$(sed -n 's/^ *volume *= *//p' /etc/glassos/sounds.conf 2>/dev/null | head -n1)"
[ -n "$vol" ] || vol=0.8

# wait (max 4s) for a sound card to show up
i=0
while ! grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; do
  i=$((i + 1)); [ $i -gt 40 ] && exit 0; sleep 0.1
done
sleep 0.3

echo "GlassOS: playing boot sound $f"
# the desktop skips its login chime right after this, so you hear one sound, not two
mkdir -p /run/glassos && touch /run/glassos/boot-sound-played
# "sysdefault" is the sound card itself. ALSA's "default" goes through PipeWire, which isn't
# running this early, so it would fail with "Host is down".
AUDIODRIVER=alsa AUDIODEV=sysdefault timeout 10 play -q -v "$vol" "$f" 2>/dev/null || \
  { case "$f" in *.wav) timeout 10 aplay -q -D sysdefault "$f" ;; esac; }
exit 0
