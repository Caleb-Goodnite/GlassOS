#!/usr/bin/env python3
"""Top bar privacy indicator: shows what is using the camera, microphone, speakers or screen
right now, and which app. Prints one JSON line for Waybar each time that changes.

Colours follow a simple rule: green = camera, orange = microphone, blue = screen sharing,
white = sound playing. Click it to open Settings > Privacy & Security, where each one can be
stopped or switched off.

Reads only this computer: PipeWire's list of audio/video streams (pw-dump) and which programs
have a camera device (/dev/video*) open.

It doesn't poll: it sleeps until PipeWire reports a change or something opens or closes a
camera, so it costs no battery while nothing happens.
"""
import ctypes
import glob
import json
import os
import select
import subprocess
import sys
import time

IN_OPEN, IN_CLOSE_WRITE, IN_CLOSE_NOWRITE, IN_CREATE = 0x20, 0x08, 0x10, 0x100
# GlassOS's own short system sounds aren't "an app playing sound"
OWN_SOUNDS = {"pw-play", "paplay", "aplay", "play", "glass-sound", "glass-soundd"}
NOT_APPS = {"pipewire", "wireplumber", "pipewire-pulse", "xdg-desktop-portal", "xdg-desktop-portal-hyprland"}


def pretty(name):
    return {"firefox-esr": "Firefox", "firefox": "Firefox", "glass-browser": "Glass Browser",
            "WebKitWebProcess": "Glass Browser"}.get(name, name)


def camera_apps():
    apps = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(f"/proc/{pid}/fd/{fd}").startswith("/dev/video"):
                    comm = open(f"/proc/{pid}/comm").read().strip()
                    if comm not in NOT_APPS:
                        apps.add(pretty(comm))
                    break
            except OSError:
                continue
    return apps


def mic_switched_off():
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "glassos", "privacy.conf")
    try:
        return "mic=off" in open(conf).read().split()
    except OSError:
        return False


def streams(objs):
    """{"mic": {...}, "out": {...}, "screen": {...}, "camera": {...}} app names from PipeWire's objects"""
    found = {"mic": set(), "out": set(), "screen": set(), "camera": set()}
    mic_off = mic_switched_off()
    # a stream node only names its app; the program's file name sits on the client that owns it
    clients = {o.get("id"): (o.get("info") or {}).get("props") or {}
               for o in objs if o.get("type") == "PipeWire:Interface:Client"}
    for o in objs:
        info = o.get("info") or {}
        props = info.get("props") or {}
        if o.get("type") != "PipeWire:Interface:Node":
            continue
        props = {**clients.get(props.get("client.id"), {}), **props}
        if mic_off and props.get("media.class") == "Audio/Source":
            # microphone switched off in Settings: keep every microphone muted, new ones too
            muted = any(p.get("mute") for p in (info.get("params") or {}).get("Props", []) if isinstance(p, dict))
            if not muted:
                subprocess.run(["wpctl", "set-mute", str(o.get("id")), "1"], timeout=5)
        if info.get("state") != "running":
            continue
        cls = props.get("media.class", "")
        app = props.get("application.name") or props.get("application.process.binary") or ""
        binary = props.get("application.process.binary", "")
        name = pretty(app or binary or "An app")
        if cls == "Stream/Input/Audio":
            found["mic"].add(name)
        elif cls == "Stream/Output/Audio":
            if binary not in OWN_SOUNDS and app not in OWN_SOUNDS:
                found["out"].add(name)
        elif cls == "Video/Source" and "xdph" in props.get("node.name", ""):
            found["screen"].add("Screen sharing")
        elif cls == "Stream/Input/Video":
            found["camera"].add(name)
    return found


ICONS = {"camera": ("", "Camera"), "mic": ("", "Microphone"),
         "screen": ("", "Screen"), "out": ("", "Sound")}


def render(state):
    tips, classes = [], []
    for key in ("camera", "mic", "screen", "out"):
        apps = sorted(state[key])
        if not apps:
            continue
        classes.append(key)
        tips.append(f"{ICONS[key][1]}: {', '.join(apps)}")
    if not classes:
        return {"text": "", "tooltip": "", "class": "idle"}
    tips.append("Click to stop or switch off")
    # Waybar can't colour single spans by class, so colours go inline
    colour = {"camera": "#5fe3a1", "mic": "#ffb15c", "screen": "#7fb6ff", "out": "#e8e9f0"}
    text = "  ".join(f"<span color='{colour[k]}'>{ICONS[k][0]}</span>" for k in classes)
    return {"text": text, "tooltip": "\n".join(tips), "class": classes}


class CameraWatch:
    """Wakes up when any program opens or closes a camera (inotify on /dev/video*), or a
    camera is plugged in."""

    def __init__(self):
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd >= 0:
            self.libc.inotify_add_watch(self.fd, b"/dev", IN_CREATE)
            self.watch()

    def watch(self):
        for dev in glob.glob("/dev/video*"):
            self.libc.inotify_add_watch(self.fd, dev.encode(), IN_OPEN | IN_CLOSE_WRITE | IN_CLOSE_NOWRITE)


class PipeWire:
    """PipeWire's objects, kept up to date from one "pw-dump --monitor": it prints every object
    once, then each object that changes ("info": null when it's gone). Only this one connection
    is used; a second pw-dump would itself show up as a change and wake us again."""

    def __init__(self):
        self.objs, self.buf, self.proc = {}, "", None
        try:
            self.proc = subprocess.Popen(["pw-dump", "--monitor", "--no-colors"], stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL)
            os.set_blocking(self.proc.stdout.fileno(), False)
        except OSError:
            pass

    def fd(self):
        return self.proc.stdout.fileno() if self.proc else -1

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def read(self):
        try:
            while True:
                chunk = os.read(self.fd(), 65536)
                if not chunk:
                    break
                self.buf += chunk.decode(errors="replace")
        except (BlockingIOError, OSError):
            pass
        dec = json.JSONDecoder()
        while True:
            self.buf = self.buf.lstrip()
            try:
                batch, end = dec.raw_decode(self.buf)
            except ValueError:
                break   # the rest hasn't arrived yet
            self.buf = self.buf[end:]
            for o in batch if isinstance(batch, list) else []:
                if o.get("info") is None:
                    self.objs.pop(o.get("id"), None)
                else:
                    self.objs[o.get("id")] = o


def drain(fd):
    try:
        while os.read(fd, 65536):
            pass
    except (BlockingIOError, OSError):
        pass


def main():
    cams = CameraWatch()
    pw = PipeWire()
    last = None
    while True:
        # sleep until something changes (a 30 s check as a safety net)
        select.select([f for f in (cams.fd, pw.fd()) if f >= 0], [], [], 30)
        time.sleep(0.3)   # a stream starting is a burst of changes: let it settle, then look once
        pw.read()
        if cams.fd >= 0:
            drain(cams.fd)
            cams.watch()  # a camera plugged in since last time
        s = streams(list(pw.objs.values()))
        s["camera"] |= camera_apps()
        msg = json.dumps(render(s))
        if msg != last:
            print(msg, flush=True)
            last = msg
        if not pw.alive():  # PipeWire restarted
            time.sleep(2)
            pw = PipeWire()


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
